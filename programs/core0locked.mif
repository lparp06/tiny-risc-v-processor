-- Core 0 Peterson-lock demo
--
-- Core 0 initializes shared variables.
-- Both cores increment the shared counter 10 times.
-- Peterson's lock prevents lost updates.
--
-- Expected final:
--   x8 = 000014   // 20 decimal
--   PC = 000084

WIDTH=32;
DEPTH=1024;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    000 : 10000293; -- addi x5,  x0, 256      ; counter address 0x100
    001 : 10400A13; -- addi x20, x0, 260      ; flag0 address 0x104
    002 : 10800A93; -- addi x21, x0, 264      ; flag1 address 0x108
    003 : 10C00B13; -- addi x22, x0, 268      ; turn address 0x10C
    004 : 11000B93; -- addi x23, x0, 272      ; start address 0x110
    005 : 11400C13; -- addi x24, x0, 276      ; done0 address 0x114
    006 : 11800C93; -- addi x25, x0, 280      ; done1 address 0x118
    007 : 00100593; -- addi x11, x0, 1        ; constant 1

    -- Initialize shared variables.
    008 : 0002A023; -- sw   x0,  0(x5)        ; counter = 0
    009 : 000A2023; -- sw   x0,  0(x20)       ; flag0 = 0
    00A : 000AA023; -- sw   x0,  0(x21)       ; flag1 = 0
    00B : 000B2023; -- sw   x0,  0(x22)       ; turn = 0
    00C : 000C2023; -- sw   x0,  0(x24)       ; done0 = 0
    00D : 000CA023; -- sw   x0,  0(x25)       ; done1 = 0
    00E : 00BBA023; -- sw   x11, 0(x23)       ; start = 1

    00F : 00A00393; -- addi x7, x0, 10        ; loop limit = 10
    010 : 00000413; -- addi x8, x0, 0         ; i = 0

    -- loop:
    -- lock for core 0:
    -- flag0 = 1;
    -- turn = 1;
    011 : 00BA2023; -- sw   x11, 0(x20)       ; flag0 = 1
    012 : 00BB2023; -- sw   x11, 0(x22)       ; turn = 1

    -- wait while flag1 == 1 && turn == 1
    013 : 000AA483; -- lw   x9,  0(x21)       ; x9 = flag1
    014 : 00048663; -- beq  x9,  x0, got_lock
    015 : 000B2503; -- lw   x10, 0(x22)       ; x10 = turn
    016 : FEB50AE3; -- beq  x10, x11, wait

    -- got_lock:
    -- critical section: counter++
    017 : 0002A483; -- lw   x9, 0(x5)         ; load counter
    018 : 00148493; -- addi x9, x9, 1         ; counter++
    019 : 0092A023; -- sw   x9, 0(x5)         ; store counter

    -- unlock: flag0 = 0
    01A : 000A2023; -- sw   x0, 0(x20)        ; flag0 = 0

    -- i++
    01B : 00140413; -- addi x8, x8, 1         ; i++
    01C : FC741AE3; -- bne  x8, x7, loop

    -- done0 = 1
    01D : 00BC2023; -- sw   x11, 0(x24)       ; done0 = 1

    -- wait for done1
    01E : 000CA503; -- lw   x10, 0(x25)       ; x10 = done1
    01F : FE050EE3; -- beq  x10, x0, wait_done1

    -- load final counter into x8
    020 : 0002A403; -- lw   x8, 0(x5)         ; x8 = final counter
    021 : 00000063; -- beq  x0, x0, 0         ; stop, PC = 0x84

    [022..3FF] : 00000013;
END;