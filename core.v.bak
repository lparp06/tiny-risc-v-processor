module core #(
	parameter CORE_ID = 0,
	parameter RESET_PC = 32'd0;
)(
	input clk,
	input rst,
	input en,
	
	// Instruction Memory interface
	output [31:0] imem_addr,
	input  [31:0] imem_rdata,

	// Data memory request interface
	output [31:0] dmem_addr,
	output [31:0] dmem_wdata,
	output		  dmem_wen,
	output 		  dmem_req,
	input  [31:0] dmem_rdata,
	input			  dmem_gnt,
	
	// debug
	input  [4:0]  debug_reg_addr,
	output [31:0] debug_reg_data,
	output [31:0] debug_pc,
	output [31:0] debug_inst,
	output [2:0]  debug_state
);

// ------------------------------------------------------------
// Local parameters
// ------------------------------------------------------------

localparam WB_ALU = 2'd0;
localparam WB_MEM = 2'd1;
localparam WB_PC4 = 2'd2;
localparam WB_IMM = 2'd3;

localparam IMM_I = 3'd0;
localparam IMM_S = 3'd1;
localparam IMM_B = 3'd2;
localparam IMM_U = 3'd3;
localparam IMM_J = 3'd4;

localparam BR_BEQ  = 3'd0;
localparam BR_BNE  = 3'd1;
localparam BR_BLT  = 3'd2;
localparam BR_BGE  = 3'd3;
localparam BR_BLTU = 3'd4;
localparam BR_BGEU = 3'd5;

localparam S_FETCH_ADDR  = 3'd0;
localparam S_FETCH_LATCH = 3'd1;
localparam S_DECODE      = 3'd2;
localparam S_EXEC        = 3'd3;
localparam S_MEM         = 3'd4;
localparam S_WB          = 3'd5;


// ------------------------------------------------------------
// FSM
// ------------------------------------------------------------

wire fsm_en;
assign fsm_en = en;

reg [2:0] S;
reg [2:0] NS;

always @ (posedge clk or negedge rst) begin
	if (!rst)	
		S <= S_FETCH_ADDR;
	else if (fsm_en)
		S <= NS;
end


// ------------------------------------------------------------
// PC
// ------------------------------------------------------------

wire [31:0] pc;

wire [31:0] pc_next;
wire 			pc_en;

pc u_pc (
	.clk		(clk),
	.rst		(rst),
	.en		(en),
	.pc_next (pc_next),
	.pc		(pc)
);

// ------------------------------------------------------------
// Instruction Memory
// ------------------------------------------------------------
assign imem_addr = pc;

// ------------------------------------------------------------
// Instruction Register / Instruction PC
// ------------------------------------------------------------

reg [31:0] inst_reg;
reg [31:0] inst_pc;

always @ (posedge clk or negedge rst) begin
	if (!rst)
		inst_pc <= 32'd0;
	else if (fsm_en && (S == S_FETCH_ADDR))
		inst_pc <= pc;
end

always @ (posedge clk or negedge rst) begin
	if (!rst)
		inst_reg <= 32'd0;
	else if (fsm_en && (S = S_FETCH_LATCH))
		inst_reg <= imem_rdata;
end

// ------------------------------------------------------------
// Decode
// ------------------------------------------------------------

wire [6:0]  opcode;
wire [4:0]  rd;
wire [2:0]  funct3;
wire [4:0]  rs1;
wire [4:0]  rs2;
wire [6:0]  funct7;

wire [31:0] imm_i;
wire [31:0] imm_s;
wire [31:0] imm_b;
wire [31:0] imm_u;
wire [31:0] imm_j;

decode u_decode (
    .inst   (inst_reg),
    .opcode (opcode),
    .rd     (rd),
    .funct3 (funct3),
    .rs1    (rs1),
    .rs2    (rs2),
    .funct7 (funct7),
    .imm_i  (imm_i),
    .imm_s  (imm_s),
    .imm_b  (imm_b),
    .imm_u  (imm_u),
    .imm_j  (imm_j)
);

// ------------------------------------------------------------
// Control
// ------------------------------------------------------------

wire       reg_wen;
wire       alu_src_imm;
wire       alu_src_pc;
wire [3:0] alu_op;
wire       mem_wen;
wire [1:0] wb_sel;
wire [2:0] imm_sel;
wire       branch;
wire [2:0] branch_type;
wire       jump;
wire       jump_reg;

control u_control (
    .opcode      (opcode),
    .funct3      (funct3),
    .funct7      (funct7),
    .reg_wen     (reg_wen),
    .alu_src_imm (alu_src_imm),
    .alu_src_pc  (alu_src_pc),
    .alu_op      (alu_op),
    .mem_wen     (mem_wen),
    .wb_sel      (wb_sel),
    .imm_sel     (imm_sel),
    .branch      (branch),
    .branch_type (branch_type),
    .jump        (jump),
    .jump_reg    (jump_reg)
);

// ------------------------------------------------------------
// Register File
// ------------------------------------------------------------
// Read port 0 reads rs1. In debug mode, the CPU is paused and read port 0 is borrowed for debug display.

wire [4:0]  rf_ra0;
wire [31:0] rf_rd0;
wire [31:0] rf_rd1;
wire        rf_wen;
wire [4:0]  rf_waddr;
wire [31:0] rf_wdata;

assign rf_ra0   = debug_reg_mode ? debug_reg_addr : rs1;
assign rf_wen   = reg_wen && fsm_en && (S == S_WB);
assign rf_waddr = rd;

regfile u_regfile (
    .clk   (clk),
    .rst   (rst),
    .ra0   (rf_ra0),
    .ra1   (rs2),
    .rd0   (rf_rd0),
    .rd1   (rf_rd1),
    .waddr (rf_waddr),
    .wdata (rf_wdata),
    .wen   (rf_wen)
);

assign debug_reg_data = rf_rd0;

// ------------------------------------------------------------
// Immediate select
// ------------------------------------------------------------

reg [31:0] imm_selected;

always @(*) begin
    case (imm_sel)
        IMM_I:   imm_selected = imm_i;
        IMM_S:   imm_selected = imm_s;
        IMM_B:   imm_selected = imm_b;
        IMM_U:   imm_selected = imm_u;
        IMM_J:   imm_selected = imm_j;
        default: imm_selected = imm_i;
    endcase
end

// ------------------------------------------------------------
// ALU
// ------------------------------------------------------------

wire [31:0] alu_a;
wire [31:0] alu_b;
wire [31:0] alu_out;

assign alu_a = alu_src_pc  ? inst_pc      : rf_rd0;
assign alu_b = alu_src_imm ? imm_selected : rf_rd1;

alu u_alu (
    .a   (alu_a),
    .b   (alu_b),
    .op  (alu_op),
    .out (alu_out)
);

// ------------------------------------------------------------
// Branch compare
// ------------------------------------------------------------

wire branch_taken;

assign branch_taken =
    branch && (
        ((branch_type == BR_BEQ)  && (rf_rd0 == rf_rd1)) ||
        ((branch_type == BR_BNE)  && (rf_rd0 != rf_rd1)) ||
        ((branch_type == BR_BLT)  && ($signed(rf_rd0) <  $signed(rf_rd1))) ||
        ((branch_type == BR_BGE)  && ($signed(rf_rd0) >= $signed(rf_rd1))) ||
        ((branch_type == BR_BLTU) && (rf_rd0 <  rf_rd1)) ||
        ((branch_type == BR_BGEU) && (rf_rd0 >= rf_rd1))
    );


// ------------------------------------------------------------
// PC / next-PC logic
// ------------------------------------------------------------

wire [31:0] pc_next;
wire [31:0] pc_plus4;
wire [31:0] inst_pc_plus4;
wire [31:0] branch_target;
wire [31:0] jal_target;
wire [31:0] jalr_target;
wire        pc_update_exec;
wire        pc_update_mem;
wire        pc_update_wb;
wire        pc_en;

assign pc_plus4      = inst_pc + 32'd4;
assign inst_pc_plus4 = inst_pc + 32'd4;
assign branch_target = inst_pc + imm_b;
assign jal_target    = inst_pc + imm_j;
assign jalr_target   = (rf_rd0 + imm_i) & 32'hFFFF_FFFE;

// Branches complete in EXEC.
// Stores complete in MEM.
// ALU/lw/jump/lui/auipc complete in WB.
assign pc_update_exec = (S == S_EXEC) && branch;
assign pc_update_mem  = (S == S_MEM)  && mem_wen;
assign pc_update_wb   = (S == S_WB);
assign pc_en          = fsm_en && (pc_update_exec || pc_update_mem || pc_update_wb);

assign pc_next =
    ((S == S_EXEC) && branch_taken) ? branch_target :
    ((S == S_EXEC) && branch)       ? pc_plus4      :
    ((S == S_WB)   && jump_reg)     ? jalr_target   :
    ((S == S_WB)   && jump)         ? jal_target    :
                                      pc_plus4;

pc u_pc (
    .clk     (clk),
    .rst     (rst),
    .en      (pc_en),
    .pc_next (pc_next),
    .pc      (pc)
);


// ------------------------------------------------------------
// Shared Data Memory Interface
// ------------------------------------------------------------

wire is_load;
wire is_store;
wire is_mem_op;

assign is_store = mem_wen;
assign is_load = (wb_sel == WB_MEM);
assign is_mem_op = is_store || is_load;

assign dmem_req = fsm_en && (S == S_MEM) && is_mem_op;
assign dmem_wen = fsm_en && (S == S_MEM) && is_store && dmem_gnt;
assign dmem_addr = alu_out;
assign dmem_wdata = rf_rd1; 


// ------------------------------------------------------------
// FSM next-state logic
// ------------------------------------------------------------

always @ (*) begin

always @(*) begin
    NS = S;

    case (S)
        S_FETCH_ADDR: begin
            NS = S_FETCH_LATCH;
        end

        S_FETCH_LATCH: begin
            NS = S_DECODE;
        end

        S_DECODE: begin
            NS = S_EXEC;
        end

        S_EXEC: begin
            if (branch)
                NS = S_FETCH_ADDR;
            else if (mem_wen)
                NS = S_MEM;
            else if (wb_sel == WB_MEM)
                NS = S_MEM;
            else
                NS = S_WB;
        end

        S_MEM: begin
           if (!dmem_gnt)
					NS = S_MEM;
			  else if (mem_wen)
				   NS = S_FETCH_ADDR;
			  else
					NS = S_WB;

        S_WB: begin
            NS = S_FETCH_ADDR;
        end

        default: begin
            NS = S_FETCH_ADDR;
        end
    endcase
end

// ------------------------------------------------------------
// Writeback
// ------------------------------------------------------------

assign rf_wdata =
    (wb_sel == WB_MEM) ? dmem_rdata    :
    (wb_sel == WB_PC4) ? inst_pc_plus4 :
    (wb_sel == WB_IMM) ? imm_selected  :
                         alu_out;
							
// ------------------------------------------------------------
// Debug / status outputs
// ------------------------------------------------------------
							
assign debug_pc = pc;
assign debug_inst = inst_reg;
assign debug_state = S;

endmodule