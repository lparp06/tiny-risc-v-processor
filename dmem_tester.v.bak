module dmem_tester #(
    parameter ADDR_BITS = 10,
    parameter DEPTH     = 1024
)(
    input              clk,
    input              rst,      // active-low reset
    input              start,

    output reg [31:0]  addr, // address to read/write
    output reg [31:0]  wdata, // data to write
    output reg         wen, // write enable
    input      [31:0]  rdata, // data read back from memory

    output reg         done, // test finished
    output reg         error, // test failed 
    output reg [ADDR_BITS-1:0] index, // currrent memory wortd being tested
    output reg [ADDR_BITS-1:0] error_index, // word address where failure happened 
    output reg [31:0]  expected, // value memory should have  returned
    output reg [31:0]  observed // value that memory actually returned 
);

// ------------------------------------------------------------
// FSM STATES
// ------------------------------------------------------------

localparam IDLE         = 3'd0;
localparam WRITE_A      = 3'd1; // write a to all addresses
localparam READ_A_SET   = 3'd2;  // ram needs clock cycle after changing address before rdata is valid
localparam READ_A_CHECK = 3'd3; // check a in each address
localparam WRITE_B      = 3'd4;  // write b to each address
localparam READ_B_SET   = 3'd5; // ram needs clock cycle after changing address before rdata is valid
localparam READ_B_CHECK = 3'd6; // check b in each address
localparam DONE         = 3'd7;

reg [2:0] S; // current state
reg [2:0] NS; // next state

// ------------------------------------------------------------
// Test patterns
// ------------------------------------------------------------


// Generate test values. For each memory word index i, the tester writes a value based on the address
// Each word contains a different value 
function [31:0] pattern_a;
    input [ADDR_BITS-1:0] i;
    begin
        pattern_a = {22'd0, i} ^ 32'hA5A55A5A; // i XOR A5A55A5A
    end
endfunction

function [31:0] pattern_b;
    input [ADDR_BITS-1:0] i;
    begin
        pattern_b = ~pattern_a(i); // bitwise inverse of pattern a(i)
    end
endfunction

// ------------------------------------------------------------
// State register
// ------------------------------------------------------------

always @(posedge clk or negedge rst) begin
    if (!rst)
        S <= IDLE;
    else
        S <= NS;
end

// ------------------------------------------------------------
// Next-state logic
// ------------------------------------------------------------

always @(*) begin
    NS = S;

    case (S)

        IDLE: begin
            if (start) // turn on sw[7]
                NS = WRITE_A;
        end

        WRITE_A: begin // writes pattern_a(index) into every memory word; stays in write_a until index counts from 0 to 1023
            if (index == DEPTH-1)
                NS = READ_A_SET;
            else
                NS = WRITE_A;
        end

        READ_A_SET: begin // memory gets one clock cycle to play selected address' data onto rdata. the ram outputs are unregistered, so this isn't necessary but it just allows for a more robust test
            NS = READ_A_CHECK;
        end

        READ_A_CHECK: begin // compares pattern_a to memory output
            if (rdata != pattern_a(index)) // if wrong, go to done with error
                NS = DONE;
            else
                NS = WRITE_B; // write pattern b to the same address (prove that memory can be changed)
        end

        WRITE_B: begin // writes inverse pattern to same memory word
            NS = READ_B_SET;
        end

        READ_B_SET: begin // wait another clock cycle
            NS = READ_B_CHECK;
        end

        READ_B_CHECK: begin // checks inverse pattern with same mux as above 
            if (rdata != pattern_b(index))
                NS = DONE;
            else if (index == DEPTH-1)
                NS = DONE; 
            else
                NS = READ_A_SET;
        end

        DONE: begin // stays in done until sw[7] is turned off
            if (!start)
                NS = IDLE;
        end

        default: begin
            NS = IDLE;
        end

    endcase
end

// ------------------------------------------------------------
// Sequential datapath/control registers
// ------------------------------------------------------------
//
// This block updates index, done, error, and captured failure info.
// State transitions are controlled by NS above.
//

always @(posedge clk or negedge rst) begin
    if (!rst) begin // clears test progress and error information
        index       <= {ADDR_BITS{1'b0}};
        done        <= 1'b0;
        error       <= 1'b0;
        error_index <= {ADDR_BITS{1'b0}};
        expected    <= 32'd0;
        observed    <= 32'd0;
    end
    else begin
        case (S)

            IDLE: begin // memory word index set to zero, clear done and error
                index <= {ADDR_BITS{1'b0}};

                if (start) begin
                    done  <= 1'b0;
                    error <= 1'b0;
                end
            end

            WRITE_A: begin // index counts upward, then wraps back to 0
                if (index == DEPTH-1)
                    index <= {ADDR_BITS{1'b0}};
                else
                    index <= index + 1'b1;
            end

            READ_A_CHECK: begin // captures failure information
                if (rdata != pattern_a(index)) begin
                    done        <= 1'b1;
                    error       <= 1'b1;
                    error_index <= index;
                    expected    <= pattern_a(index);
                    observed    <= rdata;
                end
            end

            READ_B_CHECK: begin // captures failure information
                if (rdata != pattern_b(index)) begin
                    done        <= 1'b1;
                    error       <= 1'b1;
                    error_index <= index;
                    expected    <= pattern_b(index);
                    observed    <= rdata;
                end
                else if (index == DEPTH-1) begin
                    done  <= 1'b1;
                    error <= 1'b0;
                end
                else begin
                    index <= index + 1'b1;
                end
            end

            DONE: begin
                if (!start) begin // if start goes low, go back to idle and reset status
                    done  <= 1'b0;
                    error <= 1'b0;
                    index <= {ADDR_BITS{1'b0}};
                end
            end

        endcase
    end
end

// ------------------------------------------------------------
// Output logic
// ------------------------------------------------------------

// Drives memory interface 
always @(*) begin
    addr  = {22'd0, index, 2'b00};  // byte address = index * 4
    wdata = 32'd0;
    wen   = 1'b0;

    case (S)

        WRITE_A: begin
            wdata = pattern_a(index); 
            wen   = 1'b1;
        end

        WRITE_B: begin
            wdata = pattern_b(index);
            wen   = 1'b1;
        end

        default: begin
            wdata = 32'd0;
            wen   = 1'b0; // tester can only write during write states
        end

    endcase
end

endmodule